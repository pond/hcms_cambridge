<%
  # Render with:
  #
  #   render partial: 'booleans', locals: {
  #     article: Article model instance
  #   }

  any_published    = article.revisions.any?(&:published?)
  active_draft     = article.current_revision.present? && ! article.current_revision.published

  published_markup = apphelp_boolean(any_published, no_class: 'boolean_no_highlight')
  draft_markup     = apphelp_boolean(active_draft, no_class: nil, yes_class: 'boolean_yes_highlight')
%>
<td class="centre"><%= published_markup %></td>
<td class="centre">
  <% if active_draft %>
    <%= link_to(draft_markup, [:admin, article.page, article, {revision: article.current_revision.id}]) %>
  <% else %>
    <%= draft_markup %>
  <% end %>
</td>
