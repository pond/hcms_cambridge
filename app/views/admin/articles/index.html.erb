<h1 id="admin-header-main">
  Blog &ldquo;<%= @page.title %>&rdquo;
</h1>

<div id="admin-header-with-nav">
  <h2>All articles</h2>
  <span>▶︎</span>
  <nav>
    <%= link_to 'New blog article',         new_admin_page_article_path(@page) %> |
    <%= link_to 'View article grid',        admin_page_path(@page.slug) %> |
    <%= link_to 'Back to "All pages" list', admin_pages_path() %>
  </nav>
</div>

<table class="full_width">
  <thead>
    <tr>
      <th>Title</th>
      <th>Date</th>
      <th class="centre">Published?</th>
      <th class="centre">Has draft?</th>
      <th class="centre" colspan="2">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do | article | %>

      <tr class="<%= cycle( 'even', 'odd' ) %>">
        <td><%= article.title %></td>
        <td><%= apphelp_human_time(article.created_at, date_only: true) %>
        <%= render partial: 'booleans', locals: { article: article } %>
        <%= render partial: 'actions', locals: { article: article } %>
      </tr>

    <% end %>
  </tbody>
</table>
