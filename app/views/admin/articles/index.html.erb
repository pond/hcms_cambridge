<h1>Blog &ldquo;<%= @page.title %>&rdquo;</h1>
<h2>All articles</h2>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th class="centre">Published?</th>
      <th class="centre">Has draft?</th>
      <th class="centre" colspan="2">Actions</th>
    </tr>
  </thead>

  <tbody>
<% @articles.each do | article | %>
      <tr class="<%= cycle( 'even', 'odd' ) %>">
        <td><%= article.title %></td>
        <%= render partial: 'booleans', locals: { article: article } %>
        <%= render partial: 'actions', locals: { article: article } %>
      </tr>
<% end %>
  </tbody>
</table>

<br>

<%= link_to 'New blog article', new_admin_page_article_path() %> |
<%= link_to 'Visit blog page', [ :admin, @page ] %> |
<%= link_to 'Administration', admin_pages_path() %>
