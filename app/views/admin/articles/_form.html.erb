<%= form_with(model: [:admin, @page, @article], builder: FormBuilderWithInlineErrors) do | f | %>
  <%= hidden_field_tag(:revision, params[:revision]) if params.key?(:revision) %>

  <details <%= @article.collapse_metadata_in_form? ? '' : 'open' %>>
    <summary <%= @article.collapse_metadata_in_form? ? '' : 'style="display: none"'.html_safe %>>Expand to edit article attributes</summary>

    <div class="field" <%= @article.collapse_metadata_in_form? ? 'style="margin-top: 1em"'.html_safe : '' %>>
      <%= apphelp_label(f, :title) %>
      <%= f.text_field :title %>
    </div>

    <div class="field">
      <%= apphelp_label(f, :article_hero_image) %>
      <%= f.file_field :article_hero_image %>
      <% if @article.persisted? %>
        <br>
        <small><em>
          You only need to choose an image if changing the one that's already attached to the article
        </em></small>
      <% end %>
    </div>

    <div class="field">
      <%= apphelp_label(f, :summary) %>
      <%= f.text_area :summary, cols: '60', rows: '5', style: "margin-bottom: 0" %>
      <%= f.error_markup_for(:summary) %><br>
      <small><em>A brief, plain text (no styling) summary used in the list of blog articles</em></small>
    </div>

    <div class="field">
      <div class="checkbox">
        <%= f.check_box :raw_editor %> <%= f.label :raw_editor %>
      </div>
      <small><em>
        You must <strong>save</strong> then <strong>re-edit</strong> the article if you change this setting
      </em></small>
    </div>

    <div class="field">
      <%= apphelp_label(f, :body) %>
    </div>
  </details>

  <% if @article.raw_editor %>
    <div class="redactor_container">
      <div class="redactor-box redactor-styles-on">
        <%= f.text_area :body, class: 'not_redactor', rows: 40, cols: 120 %>
      </div>
    </div>
  <% else %>
    <div class="redactor_container">
      <div id="redactor_toolbar"></div>
      <%= f.text_area :body, class: 'custom_redactor', rows: 40, cols: 120 %>
    </div>
  <% end %>
  <%= f.error_markup_for(:body) %>

  <div class="actions with_note">
    <%= f.button 'Save draft', name: 'submit' %>
    <%= f.button 'Publish article', name: 'publish', value: true %>
    <div class="note">
      Only the title, summary and article body text save in new revisions.
      <strong><em>All other changes</em> always save permanently.</strong>
    </diV>
  </div>
<% end %>
