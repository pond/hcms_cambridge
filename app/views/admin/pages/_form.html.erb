<%= form_with(model: [:admin, @page], builder: FormBuilderWithInlineErrors) do | f | %>
  <%= hidden_field_tag(:revision, params[:revision]) if params.key?(:revision) %>

  <details <%= @page.collapse_metadata_in_form? ? '' : 'open' %>>
    <summary <%= @page.collapse_metadata_in_form? ? '' : 'style="display: none"'.html_safe %>>Expand to edit page attributes</summary>

    <div class="two_column" <%= @page.collapse_metadata_in_form? ? 'style="margin-top: 1em"'.html_safe : '' %>>
      <div class="field">
        <%= apphelp_label(f, :title) %>
        <%= f.text_field :title %>
      </div>

      <div class="field">
        <%= apphelp_label(f, :slug, optional: true) %>
        <%= f.text_field :slug %>
        <br>
        <small><em>
          <% if @page.persisted? %>
            Beware if changing this &ndash; people may have bookmarked this page using its old slug
          <% else %>
            If left blank, the slug is generated automatically from the page title
          <% end %>
        </em></small>
      </div>

      <div class="field">
        <%= apphelp_label(f, :navigation_title, optional: true) %>
        <%= f.text_field :navigation_title %>
        <br>
        <small><em>
          If this is the page currently being viewed, then this text is shown in the header area above the navigation links
        </em></small>
      </div>
    </div>

    <div class="two_column">
      <div class="field">
        <%= apphelp_label(f, :page_type) %>
        <div class="contains-form-element-with-help">
          <%= f.collection_select :page_type, ::PageType.types, :internal_name, :human_name %>
          <details>
            <summary>ℹ️</summary>
            <dl>
              <dt>Normal</dt>
              <dd>A regular page with no special features.</dd>
              <dt>Booking form</dt>
              <dd>
                A page that includes a form intended for "always-on" booking options, for
                things like bespoke events held on a date and time requested by the customer.
                Use the "Events" page kind for events scheduled on a fixed date and time.
              </dd>
              <dt>Contact form</dt>
              <dd>A page that includes a "contact us" form for general purpose enquiries.</dd>
              <dt>Blog</dt>
              <dd>
                A kind of container page with no body text of its own. Within it, you write
                and publish articles which get listed automatically on the parent page, most
                recent first. Each blog page holds its own distinct set of articles; you
                can add as many separate blog collections as you want.
              </dd>
              <dt>Events</dt>
              <dd>
                A kind of container page with no body text of its own. You write details of
                forthcoming events you are holding that are scheduled for a fixed date and
                time, with addition and presentation similar to articles written for blogs.
                Customers can order event tickets directly from each event page. As with
                blogs, you can have as many separate event collections as you want.
              </dd>
            <dl>
          </details>
        </div>
      </div>

      <div>
        <% if Page.top_level.any? %>
          <div class="field">
            <%= apphelp_label(f, :page_id) %>
            <%=
              # Hidden pages *are* included so that you can assemble a tree of
              # new page items that don't appear in the menu bar until they're
              # all finished and the top-level parent is unhidden. Drafts can do
              # the same thing, but user workflow preferences differ.
              #
              f.collection_select(
                :page_id,
                Page.top_level_except(@page.id),
                :id,
                :title,
                include_blank: 'Do not put into a menu'
              )
            %>
          </div>
        <% end %>

        <div class="field">
          <div class="checkbox">
            <%= f.check_box :hidden %> <%= f.label :hidden %>
          </div>
        </div>
      </div>
    </div>

    <div class="non-blog-or-events-fields" style="display: <%= @page.can_omit_body? ? 'none' : 'block' %>">
      <div class="is-form-fields" style="display: <%= @page.is_form_type? ? 'block' : 'none' %>">
        <hr>
        <p>
          This page will contain a form which lets users send enquiries. Contact
          forms are for the generalised contact use cases you would expect. Booking
          forms are intended for "always-on" offerings such as bespoke requested
          private events. For fixed scheduled offerings, consider using an "Events"
          kind of page instead of a booking form.
        </p>
        <p>
          Except for the settings below, all form fields are preset (not editable).
        </p>

        <div class="two_column">
          <div class="field">
            <%= apphelp_label(f, :form_selection_list_label, optional: true) %>
            <%= f.text_field :form_selection_list_label %>
            <br>
            <small><em>
              Define an optional menu presented in the booking form. Enter a label to show above
              the menu and a list of item names, one per line. If the items list is empty, no
              menu is offered.
            </em></small>
          </div>

          <div class="field">
            <%= apphelp_label(f, :form_selection_list_contents, optional: true) %>
            <%= f.text_area :form_selection_list_contents, rows: 6, cols: 40 %>
            <%= f.error_markup_for(:form_selection_list_contents) %>
          </div>
        </div>

        <div class="field is-booking-fields" style="display: <%= @page.is_booking_form? ? 'block' : 'none' %>">
          <div class="checkbox">
            <%= f.check_box :hide_date_and_time %> <%= f.label :hide_date_and_time %>
          </div>
        </div>

        <hr>
        <p>
          Page contents written into the main editing area below will always appear
          <i>above</i> the enquiry form.
        </p>
      </div>

      <div class="two_column">
        <div class="field">
          <div class="checkbox">
            <%= f.check_box :raw_editor %> <%= f.label :raw_editor %>
          </div>
          <small><em>
            You must <strong>save</strong> then <strong>re-edit</strong> the page if you change this setting
          </em></small>
        </div>
      </div>
    </div>
  </details>

  <div class="non-blog-or-events-fields" style="display: <%= @page.can_omit_body? ? 'none' : 'block' %>">
    <% if @page.raw_editor %>
      <div class="redactor_container">
        <div class="redactor-box redactor-styles-on">
          <%= f.text_area :body, class: 'not_redactor', rows: 40, cols: 120 %>
        </div>
      </div>
    <% else %>
      <div class="redactor_container">
        <div id="redactor_toolbar"></div>
        <%= f.text_area :body, class: 'custom_redactor', rows: 40, cols: 120 %>
      </div>
    <% end %>
    <%= f.error_markup_for(:body) %>
  </div>

  <div class="actions with_note">
    <%= f.button 'Publish page', name: 'publish', value: true %>
    <%= f.button 'Save draft', name: 'submit' %>
    <div class="note">
      Only the page title, navigation title and body text (where relevant) save
      into new revisions. <strong><em>All other changes</em> such as position in
      menus, the "kind" of the page, or contact or booking form details are
      always saved (effectively, "published") immediately.</strong>
    </diV>
  </div>
<% end %>
