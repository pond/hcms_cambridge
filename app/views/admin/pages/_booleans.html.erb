<%
  any_published    = page.revisions.any?(&:published?)
  active_draft     = page.current_revision.present? && ! page.current_revision.published
  in_navigation    = page.for_navigation?

  published_markup = apphelp_boolean(any_published, no_class: 'boolean_no_highlight')
  draft_markup     = apphelp_boolean(active_draft, no_class: nil, yes_class: 'boolean_yes_highlight')
  in_nav_markup    = apphelp_boolean(in_navigation)
%>
<td class="centre"><%= published_markup %></td>
<td class="centre">
  <% if active_draft %>
    <%= link_to(draft_markup, [:admin, page, {revision: page.current_revision.id}]) %>
  <% else %>
    <%= draft_markup %>
  <% end %>
</td>
<td class="centre"><%= in_nav_markup %></td>
