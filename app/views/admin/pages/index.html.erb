<h1 id="admin-header-main">
  Page management
</h1>

<div id="admin-header-with-nav">
  <h2>All pages</h2>
  <span>▶︎</span>
  <nav>
    <%= link_to 'New page', new_admin_page_path %>
  </nav>
</div>

<table class="full_width">
  <thead>
    <tr>
      <th>Title</th>
      <th class="centre">Published?</th>
      <th class="centre">Has draft?</th>
      <th class="centre">Show in menu?</th>
      <th class="centre" colspan="2">Move</th>
      <th class="centre" colspan="2">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @pages.each do | page | %>

      <tr class="<%= cycle( 'even', 'odd' ) %>">
        <td><%= page.title %></td>
        <%= render partial: 'booleans', locals: { page: page } %>
        <%= render partial: 'actions', locals: { page: page } %>
      </tr>

      <% page.children.each do | child_page | %>

        <tr class="children <%= cycle( 'even', 'odd' ) %>">
          <td>&mdash; <%= child_page.title %></td>
          <%= render partial: 'booleans', locals: { page: child_page } %>
          <%= render partial: 'actions', locals: { page: child_page } %>
        </tr>

      <% end %>
    <% end %>
  </tbody>
</table>
