<%
  # Render with:
  #
  #   render partial: 'actions', locals: {
  #     page: Page model instance
  #   }
%>
<td class="admin_actions">
  <%= link_to 'Show', admin_page_path(page.slug) %>
  /
  <%= link_to 'Edit', edit_admin_page_path(page) %>
  <% if page.is_blog_type? %>
    /
    <%= link_to 'Articles', admin_page_articles_path(page) %>
  <% elsif page.is_events_type? %>
    /
    <%= link_to 'Events', admin_page_events_path(page) %>
  <% end %>
</td>
<td class="admin_actions for_delete">
  <%= link_to 'Delete', admin_page_path(page), method: :delete, data: { confirm: apphelp_destroy_confirm(page) } %>
</td>
