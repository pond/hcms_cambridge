<%
  # Render with:
  #
  #   render partial: 'actions', locals: {
  #     page: Page model instance
  #   }
%>
<td>
  <% if page.first? %>
    &nbsp;
  <% else %>
    <%= form_for(page, url: admin_move_page_path(page)) do | f | %>
    <%= f.submit('↑', name: 'higher') %>
    <% end %>
  <% end %>
</td>
<td>
  <% if page.last? %>
    &nbsp;
  <% else %>
    <%= form_for(page, url: admin_move_page_path(page)) do | f | %>
    <%= f.submit('↓', name: 'lower') %>
    <% end %>
  <% end %>
</td>
<td style="padding-right: 1em">
  <%= link_to 'Show',   [       :admin, page] %>
  <%= link_to 'Edit',   [:edit, :admin, page] %>
  <% if page.is_blog_type? %>
    <%= link_to 'Articles', [:admin, page, :articles] %>
  <% end %>
</td>
<td>
  <%= link_to 'Delete', [:admin, page], method: :delete, data: { confirm: apphelp_destroy_confirm(page) } %>
</td>
