<%
  # Render with locals 'encounter_order' holding the encounter_order
  # ActiveRecord object (with encounter associated already) and 'button_text'
  # for the submit button text.
%>
<%=
  form_with(
    model:   encounter_order,
    builder: FormBuilderWithInlineErrors,
    url:     encounter_order.new_record? ?
             admin_encounter_encounter_orders_path(encounter_id: encounter_order.encounter.slug) :
             admin_encounter_encounter_order_path(encounter_id: encounter_order.encounter.slug, id: encounter_order.id)
  ) do | f |
%>
  <%= hidden_field_tag(:price_currency,       encounter_order.encounter.currency) %>
  <%= hidden_field_tag(:price_on_application, encounter_order.price_agreed_by_application?) %>
  <%= hidden_field_tag(:price_per_seat_cents, encounter_order.frozen_price_per_seat) %>
  <%= hidden_field_tag(:price_physical_cents, encounter_order.frozen_price_physical.to_i) %>

  <hr>

  <p>
    <%= apphelp_label(f, :name, required: true, hint: "name of the person who will be paying for the encounter order") %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= apphelp_label(f, :email, required: true, hint: "the customer's encounter information and payment link is sent here") %>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= apphelp_label(f, :phone_number, hint: 'optional') %>
    <%= f.telephone_field :phone_number %>
  </p>

  <hr>

  <div class="field">
    <%= apphelp_label(f, :starts_at) %>
    <%= f.label "starts_at_kind_#{ EncounterOrder::STARTS_AT_KIND_OPEN_ENDED }" do %>
      <%=
        f.radio_button(
          :starts_at_kind,
          EncounterOrder::STARTS_AT_KIND_OPEN_ENDED,
          checked: encounter_order.starts_at.nil?
        )
      %>
      Open-ended
    <% end %>
    <div class="field-row">
      <%= f.label "starts_at_kind_#{ EncounterOrder::STARTS_AT_KIND_FIXED_DATE }" do %>
        <%=
          f.radio_button(
            :starts_at_kind,
            EncounterOrder::STARTS_AT_KIND_FIXED_DATE,
            checked: encounter_order.starts_at.present?
          )
        %>
        Fixed:
      <% end %>
      <%= f.datetime_field :starts_at %>
    </div>
  </div>

  <p>
    <%= apphelp_label(f, :has_physical) %>
    <% if encounter_order.encounter.has_physical_aspect? %>
      <%=
        f.collection_select(
          :has_physical,
          [
            ['',    'Customer chooses at checkout'],
            [true,  'Included'                    ],
            [false, 'Excluded'                    ],
          ],
          :first,
          :last
        )
      %>
    <% else %>
      This encounter has no related physical product.
      <%= f.hidden_field(:has_physical, value: false) %>
    <% end %>
  <p>

  <p>
    <%= apphelp_label(f, :number_of_seats, required: true) %>
    <%= f.number_field(:number_of_seats, min: 1) %>
    <% unless encounter_order.encounter.price_on_application? %>
      at <strong><%= evtshelp_price(encounter_order.encounter) %></strong> per seat
      <small>(<%= encounter_order.encounter.currency %>)</small>
    <% end %>
  </p>

  <% if encounter_order.encounter.price_on_application? %>
    <fieldset>
      <legend>Optional itemisation for invoice</legend>
      <div id="encounter_order_items_wrapper">
        <%= f.fields_for :encounter_order_items do |encounter_order_item_fields| %>
          <%=
            render(
              'item_fields',
              f:               encounter_order_item_fields,
              encounter_order: encounter_order
            )
          %>
        <% end %>
      </div>

      <button type="button" id="add_encounter_order_item_button">Add Item</button>

      <template id="encounter_order_item_template">
        <%= f.fields_for :encounter_order_items, EncounterOrderItem.new, child_index: 'UNIQUE_ROW_ID' do |encounter_order_item_fields| %>
          <%=
            render(
              'item_fields',
              f:               encounter_order_item_fields,
              encounter_order: encounter_order
            )
          %>
        <% end %>
      </template>
    </fieldset>
  <% end %>

  <p>
    <%
      amount_owed_hint = if encounter_order.encounter.price_on_application?
        'amount previously agreed with customer'
      else
        'optional override of calculated amount, usually used for discounted pricing'
     end
    %>
    <%= apphelp_label(f, :amount_owed, hint: amount_owed_hint) %>
    <%= Money::Currency.new(encounter_order.encounter.currency).symbol %>
    <%=
      parsed_amount = Money.from_cents(
        encounter_order.amount_owed,
        encounter_order.encounter.currency
      )

      f.text_field(
        :amount_owed,
        value: parsed_amount.zero? ? '' : parsed_amount.format(symbol: false),
        style: 'width: 5em;'
      )
    %>
    <small><%= encordshelp_currency_and_tax_suffix(encounter_order) %></small>
    <span id="encounter_order_total_amount_hint" style="display: none">
      <% if encounter_order.encounter.has_physical_aspect? && ! encounter_order.encounter.physical_aspect_free_of_charge? %>
        <small><em>
          (which will be increased by
          <%= encshelp_price(encounter_order.encounter, for_physical_aspect: true) %>
          if the customer adds the physical product at checkout)
        </em></small>
      <% end %>
    </span>
  </p>

  <p id="encounter_order_address_container">
    <%
      threshold = apphelp_money(
        Hcms.config.tax_threshold,
        currency: @encounter_order.encounter.currency
      )
    %>
    <%= apphelp_label(f, :address, hint: "mandatory for invoices above #{threshold}, else optional") %>
    <%= f.text_area :address, rows: 3, cols: 80 %>
    <%= f.error_markup_for(:address) %>
  </p>

  <p>
    <%= apphelp_label(f, :notes_to_buyer, hint: 'the customer will be able to see these') %>
    <%= f.text_area :notes_to_buyer, rows: 3, cols: 80 %>
    <%= f.error_markup_for(:notes_to_buyer) %>
  </p>

  <div class="field">
    <div class="field-row">
      <%= submit_tag(button_text, class: 'bold_button') %>
      <span>
        <% if encounter_order.new_record? %>
          The customer will <strong><em>not</em> be notified</strong> automatically.
          It is assumed that there is already an ongoing contact thread for that. A
          payment and invoice link for the customer is shown once you save the booking.
        <% else %>
          The customer won't be sent any automatic notifications about amendments.
        <% end %>
      </span>
    </div>
  </div>
<% end %>
