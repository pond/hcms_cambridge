<%
  # Render with locals 'encounter_encounter_orders' containing items to list and
  # 'encounter' holding the encounter that the encounter encounter_orders are all for.
%>

<table class="full_width">
  <thead>
    <tr>
      <th>Name</th>
      <th>E-mail address</th>
      <th>Creation date</th>
      <th>People</th>
      <th>Amount</th>
      <th>State</th>

      <th class="centre" colspan="2">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% encounter_orders.each do | encounter_order | %>

      <tr class="<%= cycle( 'even', 'odd' ) %>">
        <td><%= encounter_order.name %></td>
        <td><code><%= mail_to(encounter_order.email) %></code></td>
        <td><%= apphelp_human_time(encounter_order.created_at, date_only: true) %></td>
        <td><%= encounter_order.number_of_seats %></td>
        <td>
          <%=
            # An encounter might be free but with a for-price physical item, or
            # other future combinations; don't special-case "free" to keep it
            # simple and reliable. Just show the amount owed.
            #
            apphelp_money(
              encounter_order.amount_owed,
              currency:       encounter_order.encounter.currency,
            )
          %>
        </td>
        <td><%= encounter_order.human_state %></td>

        <%= render partial: 'actions', locals: { encounter_order: encounter_order } %>
      </tr>

    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td>&nbsp;</td>
      <td>
        <div style="display: flex; align-items: center; gap: 0.5em;">
          Copy all
          <%=
            button_tag(
              title: 'Copy all addresses',
              class: 'copy_from_data',
              style: 'font-size: 80%',
              data:  { text: encounter_orders.map(&:email).each { |e| e.gsub(',', '=2C') }.join(',') }
            ) do
          %><i class="fa fa-copy"></i><% end %>
        </div>
      </td>
      <td>&nbsp;</td>
      <td>
        <%= encounter_orders.sum(:number_of_seats) %>
      </td>
      <td>
        <%= apphelp_money(encounter_orders.sum(:amount_owed), currency: encounter.currency) %>
      </td>
      <td colspan="3">&nbsp;</td>
    </tr>
  </tfoot>
</table>
