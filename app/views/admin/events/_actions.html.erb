<%
  # Render with:
  #
  #   render partial: 'actions', locals: {
  #     event: Event model instance
  #   }
%>
<td class="admin_actions centre">
  <% if event.revisions.any?(&:published?) %>
    <%= link_to "Orders (#{event.orders.size})", admin_page_event_orders_path(event.page.slug, event.slug) %>
    <%= evtshelp_seat_state_glyph(event) %>
  <% else %>
    &ndash;
  <% end %>
</td>
<td class="admin_actions">
  <%= link_to 'Show', admin_page_event_path(event.page.slug, event.slug) %>
  <%= link_to 'Edit', edit_admin_page_event_path(event.page, event) %>
</td>
<td class="admin_actions for_delete">
  <%= link_to 'Delete', admin_page_event_path(event.page, event), method: :delete, data: { confirm: apphelp_destroy_confirm(event) } %>
</td>
