<%
  # Render with:
  #
  #   render partial: 'booleans', locals: {
  #     event: Event model instance
  #   }

  any_published    = event.revisions.any?(&:published?)
  active_draft     = event.current_revision.present? && ! event.current_revision.published

  published_markup = apphelp_boolean(any_published, no_class: 'boolean_no_highlight')
  draft_markup     = apphelp_boolean(active_draft, no_class: nil, yes_class: 'boolean_yes_highlight')
  hidden_markup    = apphelp_boolean(event.hidden, no_class: nil, yes_class: 'boolean_yes_highlight')
%>
<td class="centre"><%= published_markup %></td>
<td class="centre"><%= hidden_markup %></td>
<td class="centre">
  <% if active_draft %>
    <%= link_to(draft_markup, [:admin, event.page, event, {revision: event.current_revision.id}]) %>
  <% else %>
    <%= draft_markup %>
  <% end %>
</td>
