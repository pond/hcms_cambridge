<%
  # Render with locals 'orders' containing items to list and 'event' holding
  # the event that the orders are all for.
%>

<table class="full_width">
  <thead>
    <tr>
      <th>Name</th>
      <th>E-mail address</th>
      <th>Creation date</th>
      <th>Seats</th>
      <th>Amount</th>
      <th>State</th>
      <th class="centre" colspan="2">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% orders.each do | order | %>

      <tr class="<%= cycle( 'even', 'odd' ) %>">
        <td><%= order.name %></td>
        <td><code><%= mail_to(order.email) %></code></td>
        <td><%= apphelp_human_time(order.created_at, date_only: true) %></td>
        <td><%= order.number_of_seats %></td>
        <td>
          <% if event.free_of_charge? %>
            &ndash;
          <% else %>
            <%= ordershelp_amount(order) %>
          <% end %>
        </td>
        <td><%= order.human_state %></td>
        <%= render partial: 'actions', locals: { order: order } %>
      </tr>

    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="3">&nbsp;</td>
      <td>
        <% if event.unrestricted_seating? %>
          &ndash;
        <% else %>
          <%= orders.sum(:number_of_seats) %>
        <% end %>
      </td>
      <td>
        <% if event.free_of_charge? %>
          &ndash;
        <% else %>
          <%= apphelp_money(orders.sum(:amount_owed)) %>
        <% end %>
      </td>
      <td colspan="3">&nbsp;</td>
    </tr>
  </tfoot>
</table>
