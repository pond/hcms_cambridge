<%
  # Render with locals 'order' holding the order ActiveRecord object (with event
  # associated already) and 'button_text' for the submit button text.
%>
<%=
  form_with(
    model:   order,
    builder: FormBuilderWithInlineErrors,
    url:     order.new_record? ?
             admin_page_event_orders_path(page_id: order.event.page.slug, event_id: order.event.slug) :
             admin_page_event_order_path(page_id: order.event.page.slug, event_id: order.event.slug, id: order.id)
  ) do | f |
%>
  <%= hidden_field_tag(:price_currency,       order.event.currency) %>
  <%= hidden_field_tag(:price_per_seat_cents, order.frozen_price_per_seat.to_s) %>

  <p>
    <%= apphelp_label(f, :name, required: true) %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= apphelp_label(f, :email, required: true, hint: "the customer's order confirmation message and any other updates get sent here") %>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= apphelp_label(f, :phone_number, hint: 'optional') %>
    <%= f.telephone_field :phone_number %>
  </p>

  <p>
    <%= apphelp_label(f, :number_of_seats, required: true) %>
    <%= f.number_field(:number_of_seats, min: 1) %>
    at <strong><%= evtshelp_price(order.event) %></strong> per seat <small>(<%= order.event.currency %>)</small>
  </p>

  <p>
    <%= apphelp_label(f, :amount_owed, hint: "optional override of calculated amount, usually used for discounted pricing") %>
    <%= Money::Currency.new(Hcms.config.currency).symbol %>
    <%=
      parsed_amount = Money.from_cents(
        order.amount_owed,
        order.event.currency
      )

      f.text_field(
        :amount_owed,
        value: parsed_amount.zero? ? '' : parsed_amount.format(symbol: false),
        style: 'width: 5em;'
      )
    %>
    <small><%= Hcms.config.currency %></small>
  </p>

  <p>
    <%= apphelp_label(f, :notes, hint: 'the customer will be able to see these') %>
    <%= f.text_area :notes, rows: 3, cols: 80 %>
    <%= f.error_markup_for(:notes) %>
  </p>

  <div class="field">
    <div class="field-row">
      <%= submit_tag(button_text, class: 'bold_button') %>
      <span>
        The customer will be notified of the order details automatically, but
        payment must be manually requested (e.g. by separately e-mailing them a
        one-off Stripe payment link or bank transfer details).
      </span>
    </div>
  </div>
<% end %>
