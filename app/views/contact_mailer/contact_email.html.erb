<%
  reply_subject = "Your #{Hcms.config.site_name} enquiry"
  reply_body    = if @message.present?
    <<~MESSAGE
      You asked:

      #{@message.gsub(/^/m, "> ")}

    MESSAGE
  else
    nil
  end
%>

<h1><%= @page.title %></h1>
<h2>New message</h2>

<dl>
  <dt>From</dt>
  <dd><%= @name %></dd>

  <dt>E-mail address</dt>
  <dd><%= mail_to(@email, subject: reply_subject, body: reply_body) %></dd>

  <dt>Phone number</dt>
  <dd><%= @phone.present? ? link_to(@phone, "tel:#{@phone}") : 'Not given' %></dd>

  <% unless @menu.blank? %>
    <dt><%= @page.form_selection_list_label.presence || 'Menu selection' %></dt>
    <dd><%= @menu %></dd>
  <% end %>
</dl>

<h2>Details</h2>

<%= simple_format(@message.presence || 'None') %>

<h2>Following up</h2>

<strong>Do not reply to this message</strong> - to compose a reply, please use
<%= mail_to(@email, 'this link', subject: reply_subject, body: reply_body) %>.
