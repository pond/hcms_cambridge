<%
  # Render with locals 'page' giving the Page to render, with delegation set up
  # to pull data from an appropriate Revision (by default - published, falling
  # back the only unpublished revision if nothing is published).
  #
  #   render partial: 'shared/page', locals: { page: @page }
%>
<%= render partial: 'shared/editable_revisions', locals: { editable: page, form_path: admin_page_path(page) } %>

<% if page.is_blog_type? %>

  <% if page.articles.for_navigation.any? %>
    <section class="blog-articles<%= page.poster_grid ? ' with-poster-grid' : ''%>">
      <% page.articles.for_navigation.each do | article | %>
        <article class="article">
          <%= link_to page_article_path(page_id: page.slug, id: article.slug), class: 'article-link' do %>
            <img class="article-hero-image" src="<%= article.article_hero_image.url %>" alt="<%= article.title %>">
            <div class="article-date-and-heading-container">
              <h4 class="article-heading"><%= article.title %></h4>
              <div class="article-date"><%= apphelp_human_time(article.created_at) %></div>
            </div>
            <div class="article-summary"><%= article.summary %></div>
          <% end %>
        </article>
      <% end %>
    </section>
  <% else %>
    <p>
      No articles have been written for this blog yet.
    </p>

    <% if current_user %>
      <p>
        <%= link_to 'Write new article', new_admin_page_article_path(page_id: page.id) %>
      </p>
    <% end %>
  <% end %>

<% elsif page.is_events_type? %>

  <% if page.events.for_navigation.any? %>
    <section class="events with-poster-grid">
      <% page.events.for_navigation.each do | event | %>
        <article class="event">
          <%= link_to page_event_path(page_id: page.slug, id: event.slug), class: 'event-link' do %>
            <img class="event-hero-image" src="<%= event.event_hero_image.url %>" alt="<%= event.title %>">
            <div class="event-date-and-heading-container">
              <h4 class="event-heading"><%= event.title %></h4>
              <div class="event-date-and-location"><%= apphelp_human_time(event.starts_at) %></div>
            </div>
            <div class="event-summary"><%= event.summary %></div>
          <% end %>
        </article>
      <% end %>
    </section>
  <% else %>
    <p>
      There are no events scheduled for the near future, but please check back later!
    </p>

    <% if current_user %>
      <p>
        <%= link_to 'Add new event now', new_admin_page_event_path(page_id: page.id) %>
      </p>
    <% end %>
  <% end %>

<% elsif page.is_form_type? %>

  <%= page.body.html_safe() %>

  <%=
    form_with(
      model:   @form_model,
      builder: FormBuilderWithInlineErrors,
      url:     user_emails_path(page_id: @page.id)
    ) do | f |
  %>
    <% if page.body.present? %>
      <hr>
    <% end %>
    <p>
      <%= apphelp_label(f, :name, required: true) %>
      <%= f.text_field :name %>
    </p>
    <p>
      <%= apphelp_label(f, :email, required: true) %>
      <%= f.email_field :email %>
    </p>
    <p>
      <%= apphelp_label(f, :phone) %>
      <%= f.telephone_field :phone %>
    </p>
    <hr>
    <% if page.is_booking_form? && ! page.hide_date_and_time %>
      <p>
        <%= apphelp_label(f, :date) %>
        <%= f.date_field :date, min: Date.current + 2.days %>
      </p>
      <p>
        <%= apphelp_label(f, :time) %>
        <%= f.time_field :time, min: '10:00', max: '19:00', step: 30.minutes %>
      </p>
    <% end %>
    <% unless page.form_selection_list_contents.strip.blank? %>
      <p>
        <%= apphelp_label(f, :menu_selection, text: page.form_selection_list_label) %>
        <%= pageshelp_form_page_selection_list(f, page) %>
      <p>
    <% end %>
    <% if page.is_booking_form? %>
      <p>
        <%= apphelp_label(f, :notes) %>
        <%= f.text_area :notes, rows: 8, cols: 80, placeholder: 'List of attendees, special date/time requests, questions etc.' %>
      </p>
    <% else %>
      <p>
        <%= apphelp_label(f, :message) %>
        <%= f.text_area :message, rows: 8, cols: 80 %>
        <%= f.error_markup_for(:message) %>
      </p>
    <% end %>

    <% if ENV["RECAPTCHA_PUBLIC_KEY"].present? %>
      <%= recaptcha_tags() %>
    <% else %>
      <%= recaptcha_v3(action: 'contact') %>
    <% end %>

    <p>
      <% if page.is_booking_form? %>
        <%= submit_tag 'Send enquiry' %>
      <% else %>
        <%= submit_tag 'Send message' %>
      <% end %>
    </p>
  <% end %>

<% else %>

  <%= page.body.html_safe() %>

<% end %>
