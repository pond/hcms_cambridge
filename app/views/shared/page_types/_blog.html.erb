<%
  # Render the body for a 'blog' type page. Usually only rendered via the
  # "shared/_page.html.erb" Partial. Requires local "page", holding the Page
  # instance that is being rendered.
%>

<% if page.articles.for_navigation.any? %>
  <section class="blog-articles<%= page.poster_grid ? ' with-poster-grid' : ''%>">
    <% page.articles.for_navigation.includes(:revisions).each do | article | %>
      <article class="article">
        <%= link_to page_article_path(page_id: page.slug, id: article.slug), class: 'article-link' do %>
          <img class="article-hero-image" src="<%= article.article_hero_image.url %>" alt="<%= article.title %>">
          <div class="article-date-and-heading-container">
            <h4 class="article-heading"><%= article.title %></h4>
            <div class="article-date"><%= apphelp_human_time(article.created_at) %></div>
          </div>
          <div class="article-summary"><%= article.summary %></div>
        <% end %>
      </article>
    <% end %>
  </section>
<% else %>
  <p>
    No articles have been written for this blog yet.
  </p>

  <% if current_user %>
    <p>
      <%= link_to 'Write new article', new_admin_page_article_path(page_id: page.id) %>
    </p>
  <% end %>
<% end %>
