<%
  # Render the body for a 'contact form' type page. Usually only rendered via
  # the "shared/_page.html.erb" Partial. Requires local "page", holding the Page
  # instance that is being rendered and "form_model" holding an instance of a
  # "Forms::..." subclass with the "pagelike" field filled in.
%>

<%= page.body.html_safe() %>

<% if page.body.present? %>
  <hr>
<% end %>

<%=
  render(
    partial: 'shared/components/contact_form',
    locals:  {
      form_model: form_model,
      form_path:  user_emails_path(page_id: page.id)
    }
  )
%>
