<%
  # Render the body for an 'encounters' type page. Usually only rendered via the
  # "shared/_page.html.erb" Partial. Requires local "page", holding the Page
  # instance that is being rendered.

  most_recent_category = nil
%>

<%= page.body.html_safe() %>

<% page.cached_encounters.each do | encounter | %>
  <% if encounter.category != most_recent_category %>
    <% most_recent_category = encounter.category %>
    <h2><%= encounter.category %></h2>
  <% end %>
  <article class="encounter">
    <section class="encounter-body-and-poster in-encounter-type-page">
      <section class="encounter-poster">
        <%= image_tag(encounter.encounter_hero_image.url, alt: encounter.title) %>
      </section>
      <section class="encounter-body">
        <p>
          <strong><%= encounter.title %></strong>
        </p>
        <%= encounter.body.html_safe() %>
        <%=
          link_to(
            'More Info',
            encounter_path(encounter),
            class: 'bold_button'
          )
        %>
      </section>
    </section>
  </article>
<% end %>
