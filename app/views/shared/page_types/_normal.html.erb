<%
  # Render the body for a 'normal' type page. Usually only rendered via the
  # "shared/_page.html.erb" Partial. Requires local "page", holding the Page
  # instance that is being rendered.
  #
  contents = page.body

  if contents.include?('{{encounters}}')
    encounter_markup = capture { render partial: "shared/page_types/encounters_insert" }
    contents.sub!('{{encounters}}', encounter_markup)
  end
%>
<%= contents.html_safe() %>
