<% most_recent_category = nil %>
<% Encounter.all.each do | encounter | %>
  <% if encounter.category != most_recent_category %>
    <% most_recent_category = encounter.category %>
    <h2><%= encounter.category %></h2>
  <% end %>
  <section class="encounter-body-and-poster" style="display: flex; gap: 1em;">
    <section class="encounter-poster" style="width: 40%;">
      <%= image_tag(encounter.encounter_hero_image.url, alt: encounter.title, style: "width: 100%; border-radius: 5px;") %>
    </section>
    <section class="encounter-body" style="width: 60%;">
      <p style="margin-top: 0; font-size: 125%;">
        <strong><%= encounter.title %></strong>
      </p>
      <%= encounter.body.html_safe() %>

      TODO: This as a form maybe? Or at least have the "Show" view as a form.
      "Enquire Today" skips the prices, but could just have price and location
      meta inline right here, as in "_encounter.html.erb".

      <%= encshelp_enquiries_or_booking_button(encounter, always_as_enquiries: true) %>
    </section>
  </section>
<% end %>
