<%
  # Render with locals 'event' giving the Event to render, with delegation
  # set up to pull data from an appropriate Revision (by default - published,
  # falling back the only unpublished revision if nothing is published).
  #
  #   render partial: 'shared/event', locals: { event: @event }
%>
<%= render partial: 'shared/editable_revisions', locals: { editable: event, form_path: admin_page_event_path(event.page, event) } %>

<article class="event">
  <section class="event-header">
    <div class="event-date-and-heading-container">
      <h2 class="event-heading"><%= event.title %></h2>
      <div class="event-date"><%= apphelp_human_time(event.created_at) %></div>
    </div>
    <div class="event-summary-and-links-container">
      <div class="event-summary">
        <%= event.summary %>
      </div>
      <div class="event-next-prev">
        <% if event.next %>
          <%= link_to('◀︎', page_event_path(page_id: event.page.slug, id: event.next.slug), title: "Newer: #{event.next.title}", rel: "newer") %>
        <% end %>
        <% if event.prev %>
          <%= link_to('▶︎', page_event_path(page_id: event.page.slug, id: event.prev.slug), title: "Older: #{event.prev.title}", rel: "older") %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="event-body">
    <%= event.body.html_safe() %>
  </section>
</article>
