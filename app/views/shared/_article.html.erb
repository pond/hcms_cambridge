<%
  # Render with locals 'article' giving the Article to render and 'revision'
  # giving the Revision of that article that should be shown:
  #
  #   render partial: 'shared/article', locals: { article: @article, revision: @revision }
%>
<article class="article">
  <section class='blog-header'>
    <div class="article-date-and-heading-container">
      <h2 class="article-heading"><%= revision.title %></h2>
      <div class="article-date"><%= apphelp_human_time(article.created_at) %></div>
    </div>
    <div class="article-summary"><%= revision.summary %></div>
  </section>

  <%= revision.body.html_safe() %>
</article>
