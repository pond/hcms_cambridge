<%
  # Render with locals 'article' giving the Article to render, with delegation
  # set up to pull data from an appropriate Revision (by default - published,
  # falling back the only unpublished revision if nothing is published).
  #
  #   render partial: 'shared/article', locals: { article: @article }
%>
<%= render partial: 'shared/components/editable_revisions', locals: { editable: article, form_path: admin_page_article_path(article.page, article) } %>

<article class="article">
  <section class="article-header">
    <div class="article-date-and-heading-container">
      <h2 class="article-heading"><%= article.title %></h2>
      <div class="article-date"><%= apphelp_human_time(article.created_at) %></div>
    </div>
    <div class="article-summary-and-links-container">
      <div class="article-summary">
        <%= article.summary %>
      </div>
      <div class="article-next-prev">
        <% if article.next %>
          <%= link_to('◀︎', page_article_path(page_id: article.page.slug, id: article.next.slug), title: "Newer: #{article.next.title}", rel: "newer") %>
        <% end %>
        <% if article.prev %>
          <%= link_to('▶︎', page_article_path(page_id: article.page.slug, id: article.prev.slug), title: "Older: #{article.prev.title}", rel: "older") %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="article-body">
    <%= article.body.html_safe() %>
  </section>
</article>
