<h1><%= @page.title %></h1>
<h2>New booking enquiry</h2>

<dl>
  <dt>From</dt>
  <dd><%= @name %></dd>

  <dt>E-mail address</dt>
  <dd><%= link_to(@email, "mailto:#{@email}") %></dd>

  <dt>Phone number</dt>
  <dd><%= @phone.present? ? link_to(@phone, "tel:#{@phone}") : 'Not given' %></dd>

  <% unless @page.hide_date_and_time %>
    <dt>Date</dt>
    <dd><%= @date.presence || 'None specified' %></dd>

    <dt>Preferred time</dt>
    <dd><%= @time.presence || 'None specified' %></dd>
  <% end %>

  <% unless @menu.blank? %>
    <dt><%= @page.form_selection_list_label.presence || 'Menu selection' %></dt>
    <dd><%= @menu %></dd>
  <% end %>
</dl>

<h2>Other notes</h2>

<%= simple_format(@notes.presence || 'None') %>
