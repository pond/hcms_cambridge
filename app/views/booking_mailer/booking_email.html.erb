<% reply_subject = "Your #{Hcms.config.site_name} booking enquiry" %>

<h1><%= @pagelike.title %></h1>
<h2>New booking enquiry</h2>

<dl>
  <dt>From</dt>
  <dd><%= @name %></dd>

  <dt>E-mail address</dt>
  <dd><%= mail_to(@email, subject: reply_subject) %></dd>

  <dt>Phone number</dt>
  <dd><%= @phone.present? ? link_to(@phone, "tel:#{@phone}") : 'Not given' %></dd>

  <% unless @pagelike.hide_date_and_time %>
    <dt>Date</dt>
    <dd><%= @date.presence || 'None specified' %></dd>

    <dt>Preferred time</dt>
    <dd><%= @time.presence || 'None specified' %></dd>
  <% end %>

  <% unless @menu.blank? %>
    <dt><%= @pagelike.form_selection_list_label.presence || 'Menu selection' %></dt>
    <dd><%= @menu %></dd>
  <% end %>
</dl>

<h2>Other notes</h2>

<%= simple_format(@notes.presence || 'None') %>

<h2>Following up</h2>

<strong>Do not reply to this message</strong> - to compose a reply, please use
<%= mail_to(@email, 'this link', subject: reply_subject) %>.
