<%
  # Render with locals 'order' holding the order ActiveRecord object (with event
  # associated already) and 'button_text' for the submit button text.
%>

<p>
  Thanks for your interest in this event! Although we can't take reservations or
  bookings for it right now, sometimes spare seats become available. If they
  do, waitlist requests are processed in order of reception. We'll contact you
  using the details below.
</p>

<%=
  form_with(
    model:   order,
    builder: FormBuilderWithInlineErrors,
    url:     event_waitlist_path(event_id: order.event.slug),
    method:  :post
  ) do | f |
%>
  <p>
    <%= apphelp_label(f, :name, required: true) %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= apphelp_label(f, :email, required: true) %>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= apphelp_label(f, :phone_number, hint: 'optional') %>
    <%= f.telephone_field :phone_number %>
  </p>

  <p>
    <%= apphelp_label(f, :number_of_seats, required: true) %>
    <%= f.number_field(:number_of_seats, min: 1) %>
    at <strong><%= evtshelp_price(order.event) %></strong> per seat <small>(<%= order.event.currency %>)</small>
  </p>

  <% if ENV["RECAPTCHA_PUBLIC_KEY"].present? %>
    <%= recaptcha_tags() %>
  <% else %>
    <%= recaptcha_v3(action: 'waitlist') %>
  <% end %>

  <p>
    <%= submit_tag('Confirm', class: 'bold_button') %>
  </p>
<% end %>
