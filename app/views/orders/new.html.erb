<article class="event-order-form-container">
  <section class="event-order-form">
    <h1><%= evtshelp_booking_action_title(@event) || 'Event' %></h1>
    <h2><%= @event.title %></h2>

    <%= render partial: @event.state, locals: { foo: true, page: @page, event: @event, order: @order } %>
  </section>

  <section class="event-order-poster">
    <%= link_to page_event_path(page_id: @page.slug, id: @event.slug), style: "display: inline-block; margin-top: 30px;" do %>
      <%= image_tag(@event.event_hero_image.url, alt: @event.title) %>
    <% end %>
  </section>
</article>
