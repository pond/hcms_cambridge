<%
  # Render with locals 'order' holding the order ActiveRecord object (with event
  # associated already) and 'button_text' for the submit button text.
%>
<%=
  form_with(
    model:   order,
    builder: FormBuilderWithInlineErrors,
    url:     page_event_orders_path(page_id: order.event.page.slug, event_id: order.event.slug),
    method:  :post
  ) do | f |
%>
  <%= hidden_field_tag(:with_order, params[:with_order]) if params[:with_order].present? %>

  <p>
    <%= apphelp_label(f, :name, required: true) %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= apphelp_label(f, :email, required: true, hint: "we'll send your receipt and any other updates here") %>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= apphelp_label(f, :phone_number, hint: 'optional') %>
    <%= f.telephone_field :phone_number %>
  </p>

  <%# TODO: Fix me; obviously, this should be dynamic depending on multiplied total %>
  <%# TODO: Fix me; configurable address-required threshold %>
  <% if Hcms.config.tax_threshold.is_a?(Integer) && @event.price_per_seat > Hcms.config.tax_threshold %>
    <p>
      For this event, a full tax invoice and receipt needs to include an address.
    </p>

    <p>
      <%= apphelp_label(f, :address, required: true) %>
      <%= f.text_area(:address, rows: 5, cols: 50) %>
      <%= f.error_markup_for(:address) %>
    </p>
  <% end %>

  <p>
    <% if @event.number_of_seats == 1 %>
      <%= f.hidden_field(:number_of_seats, value: '1') %>
      Total amount <strong><%= evtshelp_price(order.event) %></strong> <small>(<%= order.event.currency %>)</small>
    <% else %>
      <%= apphelp_label(f, :number_of_seats, required: true) %>
      <%= f.number_field(:number_of_seats, min: 1) %> at
      <strong><%= evtshelp_price(order.event) %></strong> per seat <small>(<%= order.event.currency %>)</small>
    <% end %>
  </p>

  <% unless Hcms.config.hide_order_notes %>
    <p>
      <%= apphelp_label(f, :notes) %>
      <%= f.text_area :notes, rows: 3, cols: 80, placeholder: 'Optional booking notes, questions etc.' %>
      <%= f.error_markup_for(:notes) %>
    </p>
  <% end %>

  <% if ENV["RECAPTCHA_PUBLIC_KEY"].present? %>
    <%= recaptcha_tags() %>
  <% else %>
    <%= recaptcha_v3(action: 'order') %>
  <% end %>

  <p>
    <%= submit_tag(button_text, class: 'bold_button') %>
  </p>
<% end %>
