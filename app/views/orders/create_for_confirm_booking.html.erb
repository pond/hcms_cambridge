<article class="event-order-form-container">
  <section class="event-order-form">
    <h1><%= evtshelp_booking_action_title(@order.event) || 'Event' %></h1>
    <h2><%= @order.event.title %></h2>

    <p>
      <%=
        t(
          'views.orders.confirm.booking',
          count: @order.number_of_seats,
          event_title: @order.event.title
        )
      %>
    </p>

    <ul>
      <li><%= evtshelp_datetime(@order.event) %></li>
      <li><%= @order.event.location %></li>
      <li>
        Confirmation and updates will be sent to you by e-mail at
        <strong><%= @order.email %></code></strong>
      </li>
    </ul>

    <p>
      The amount payable is
      <%= @order.number_of_seats %> &times;
      <%= evtshelp_price(@order.event) %> &equals;
      <strong><big>
        <%= apphelp_money(@order.frozen_price_per_seat * @order.number_of_seats, currency: @order.event.currency) %>
      </big></strong>
    </p>

    <div class="row-wide-column-small">
      <%=
        button_to(
          '<strong>Pay now</strong>'.html_safe(),
          manage_order_path(
            order_id: @order.id,
            token:    @order.token,
          ),
          {
            method: :patch,
            class:  'bold_button',
            params: {
              process:  'state',
              event:    'pay',
            }
          }
        )
      %>

      <%=
        button_to(
          'Amend details',
          new_page_event_order_path(),
          method: :get,
          params: { with_order: @order.id }
        )
      %>

      <%=
        button_to(
          'Cancel booking',
          page_event_order_path(
            page_id:  @order.event.page.slug,
            event_id: @order.event.slug,
            id:       @order.id
          ),
          method: :delete,
        )
      %>
    </div>
  </section>

  <section class="event-order-poster">
    <%= link_to page_event_path(page_id: @order.event.page.slug, id: @order.event.slug) do %>
      <%= image_tag(@order.event.event_hero_image.url, alt: @order.event.title) %>
    <% end %>
  </section>
</article>
