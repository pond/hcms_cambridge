<h2>Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), builder: FormBuilderWithInlineErrors, html: { method: :put }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <% hint = @minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil %>
    <%= apphelp_label(f, :password, text: "New password", hint: hint) %>
    <%= f.password_field :password, autofocus: true, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= apphelp_label(f, :password_confirmation, text: "Confirm new password", hint: hint) %>
    <%= f.password_field :password_confirmation, autocomplete: "off" %>
  </div>

  <div class="actions">
    <%= f.submit "Change my password" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
