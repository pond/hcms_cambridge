<h2>Forgot your password?</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), builder: FormBuilderWithInlineErrors, html: { method: :post }) do |f| %>
  <div class="field">
    <%= apphelp_label(f, :email) %>
    <%= f.email_field :email, autofocus: true %>
  </div>

  <div class="actions">
    <%= f.submit "Send me password reset instructions" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
