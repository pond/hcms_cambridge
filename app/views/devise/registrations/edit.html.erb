<h2>Edit <%= resource_name.to_s.humanize %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), builder: FormBuilderWithInlineErrors, html: { method: :put }) do |f| %>
  <div class="field">
    <%= apphelp_label(f, :email) %>
    <%= f.email_field :email, autofocus: true %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <%= apphelp_label(f, :password, hint: "leave blank if you don't want to change it") %>
    <%= f.password_field :password, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= apphelp_label(f, :password_confirmation) %>
    <%= f.password_field :password_confirmation, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= apphelp_label(f, :current_password, hint: "we need your current password to confirm your changes") %>
    <%= f.password_field :current_password, autocomplete: "off" %>
  </div>

  <div class="actions">
    <%= f.submit "Update" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<p>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: apphelp_destroy_confirm(resource) }, method: :delete %></p>

<%= link_to "Back", :back %>
