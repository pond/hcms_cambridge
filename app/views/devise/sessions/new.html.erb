<h1>Log in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= apphelp_label(f, :email) %>
    <%= f.email_field :email, autofocus: true %>
  </div>

  <div class="field">
    <%= apphelp_label(f, :password) %>

    <div class="field-row">
      <%= f.password_field :password, autocomplete: "off" %>
      <button class="accessory" type="button" id="admin_user_password_toggle">👁️</button>
      <script type="text/javascript">
        const passwordInput = document.getElementById('admin_user_password');
        const toggleButton = document.getElementById('admin_user_password_toggle');

        toggleButton.addEventListener('click', function(event) {
          if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleButton.textContent = '🔒';
          } else {
            passwordInput.type = 'password';
            toggleButton.textContent = '👁️';
          }

          event.preventDefault();
        });
      </script>
    </div>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <div class="checkbox">
        <%= f.check_box :remember_me %> <%= f.label :remember_me %>
      </div>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Log in" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
