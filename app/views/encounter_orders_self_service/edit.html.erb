<%= javascript_include_tag 'minimal' %>

<h1>Manage booking for &ldquo;<%= @encounter.title %>&rdquo;</h1>

<p>
  Full encounter information can be
  <%= tag.strong link_to('found here', encordshelp_share_link(@encounter_order)) %>.
</p>

<dl>
  <dt>Date and time</dt>
  <dd><%= encordshelp_datetime(@encounter_order) %></dd>
  <dt>People and price</dt>
  <dd>
    <%= @encounter_order.number_of_seats %> →
    <% if @encounter_order.amount_owed.zero? %>
      No charge
    <% else %>
      <%= encordshelp_amount_excl_and_incl_for(@encounter_order) %>
    <% end %>
    <% if @encounter_order.has_physical %>
      <% if (@encounter_order.frozen_price_physical || 0).zero? %>
        (including free <%= @encounter.name_physical %>)
      <% else %>
        (including <%= apphelp_money(@encounter_order.frozen_price_physical, currency: @encounter.currency) %>
        for <%= @encounter.name_physical %>)
      <% end %>
    <% end %>
  </dd>

  <% if @encounter_order.state_paid? %>
    <dt>Gift link</dt>
    <dd>
      If this is a gift, share this web link with recipients:<br>
      <% magic_link = encordshelp_share_link(@encounter_order) %>
      <%=
        button_tag(
          title: 'Copy link',
          class: 'copy_from_data',
          style: 'font-size: 85%',
          data:  { text: magic_link }
        ) do
      %><i class="fa fa-copy"></i><% end %>
      <small>
        <code><%= magic_link %></code>
      </small>
    </dd>
  <% end %>
</dl>

<dl>
  <dt>Your name</dt>
  <dd><%= @encounter_order.name %>
  <dt>E-mail address<dt>
  <dd><code><%= @encounter_order.email %></code></dd>
  <% if @encounter_order.phone_number.present? %>
    <dt>Phone number</dt>
    <dd>
      <%= tag.code(@encounter_order.phone_number) %>
    </dd>
  <% end %>
</dl>

<dl>
  <dt>Booking state</dt>
  <dd><%= @encounter_order.human_state %></dd>
  <% if @encounter_order.notes_to_buyer.present? %>
    <dt>Other notes</dt>
    <dd><%= @encounter_order.notes_to_buyer %></dd>
  <% end %>
  <% if @encounter_order.gift_note.present? %>
    <dt>Gift message</dt>
    <dd><%= @encounter_order.gift_note %></dd>
  <% end %>
</dl>

<% if @encounter_order.customer_self_service_possible? %>
  <%=
    form_with(
      model:   @encounter_order,
      builder: FormBuilderWithInlineErrors,
      url:     manage_encounter_order_path(
        encounter_order_id: @encounter_order.id,
        token:              @encounter_order.token,
      )
    ) do | f |
  %>
    <%= hidden_field_tag(:id_for_changes,         @encounter_order.id) %>
    <%= hidden_field_tag(:token_for_changes,      @encounter_order.token) %>
    <%= hidden_field_tag(:amount_for_seats_cents, @encounter_order.amount_owed) %>
    <%= hidden_field_tag(:price_physical_cents,   @encounter_order.frozen_price_physical.to_i) %>
    <% if Hcms.config.tax_threshold.is_a?(Integer) %>
      <%= hidden_field_tag(:address_required_threshold_cents, Hcms.config.tax_threshold) %>
    <% end %>

    <div class="field">
      <%= apphelp_label(f, :gift_note, hint: 'Appears on the encounter details page') %>
      <%= f.text_area :gift_note, rows: 3, cols: 80 %>
      <%= f.error_markup_for(:gift_note) %>
    </div>

    <% if ! @encounter_order.frozen_price_physical.nil? %>
      <% if @encounter_order.user_chooses_has_physical %>
        <div class="field">
          <%= f.label(:has_physical) do %>
            <%= f.check_box :has_physical %>
            <%=
              if @encounter_order.frozen_price_physical.zero?
                "Include free #{@encounter.name_physical}?"
              else
                "Add #{@encounter.name_physical} for #{apphelp_money(@encounter_order.frozen_price_physical, currency: @encounter.currency)}?"
              end
            %>
            <small><em>
              (Price <strong><u>excludes</u> postage</strong>; please enquire
              after booking for collection or postage options)
            </em></small>
          <% end %>
        </div>
      <% elsif @encounter_order.has_physical %>
        <div style="display: none">
          <%= f.check_box :has_physical, disabled: true %><%# Makes JavaScript simpler if always a check box %>
        </div>
      <% end %>
    <% end %>

    <div class="field" id="encounter_order_address_entry" style="display: none">
      <%= apphelp_label(f, :address) %>
      <%= f.text_area :address, rows: 5, cols: 40 %>
      <%= f.error_markup_for(:address) %>
    </div>

    <div class="row-wide-column-small-container">
      <div class="row-wide-column-small">
        <% if @encounter_order.may_pay_state? %>
          <% spms = @encounter_order.decorated_supported_payment_methods %>
          <% spms = spms.first if @encounter_order.amount_owed.zero? %>
          <% spms.each do | spm | %>
            <% if spms.size == 1 %>
              <%=
                f.button(
                  @encounter_order.amount_owed.zero? ? 'Finalise booking' : 'Pay now',
                  {
                    type:  :submit,
                    name:  'state_pay',
                    value: spm.internal_name,
                    class: 'bold_button'
                  },
                )
              %>
            <% elsif spm.is_other? %>
              <%=
                f.button(
                  "Pay another way",
                  {
                    type:  :submit,
                    name:  'state_pay',
                    value: spm.internal_name,
                    class: 'bold_button'
                  },
                )
              %>
            <% else %>
              <%=
                f.button(
                  "Pay using #{spm.human_name}",
                  {
                    type:  :submit,
                    name:  'state_pay',
                    value: spm.internal_name,
                    class: 'bold_button'
                  },
                )
              %>
            <% end %>
          <% end %>
        <% end %>
        <% if @encounter_order.may_cancel_state? %>
          <%=
            f.submit(
              'Cancel',
              {
                name: 'state_cancel',
                data: { confirm: 'Are you sure you want to cancel?' }
              }
            )
          %>
        <% end %>
        <% if @encounter_order.may_pay_state? %>
          <%=
            # Whether paid or not, there's an invoice link; for corporations especially
            # they usually want an "amount owed" tax invoice before payment, as well as
            # sometimes one showing "paid" afterwards.
            #
            link_to(
              'Invoice',
              encounter_encounter_order_invoice_path(
                encounter_id:       @encounter.slug,
                encounter_order_id: @encounter_order.id,
              ),
              {
                id:     'encounter_order_invoice_button',
                class:  'bold_button',
                style:  'margin-left: auto;',
                target: '_blank'
              }
            )
          %>
        <% end %>
      </div>
    </div>
  <% end %>

<% else %>

  <div class="row-wide-column-small-container">
    <div class="row-wide-column-small">
      <span>
        <% if @encounter_order.state_paid? %>
          The booking has been paid for successfully. If you think you need to
          cancel and request a refund,
        <% else %>
          This booking is in a finalised state. No further actions are available.
          <br>
          For help,
        <% end %>
        please contact us by e-mail at
        <%= mail_to(Hcms.config.orders_email) %> or by phone on
        <%= link_to(Hcms.config.contact_tel_human, "tel:#{Hcms.config.contact_tel_human}") %>.
      </span>

      <% if @encounter_order.state_paid? %>
        <%=
          link_to(
            'Invoice',
            encounter_encounter_order_invoice_path(
              encounter_id:       @encounter.slug,
              encounter_order_id: @encounter_order.id,
            ),
            {
              class:  'bold_button',
              target: '_blank'
            }
          )
        %>
      <% end %>
    </div>
  </div>

<% end %>
