<%# Render with current Page or Article in "content" and make sure you have %>
<%# declared "content_for :signed_in_cms_menu { ... }" before rendering.    %>

<section class="footer_content">
  <nav class="cms_menu">
    <% if user_signed_in? %>
      <%= content_for :signed_in_cms_menu %>
    <% elsif Hcms.config.hide_contact_info %>
      <% first_contact_page = Page.where(page_type: Page::PAGE_TYPE_CONTACT_FORM).first %>
      <% if first_contact_page.present? %>
        <%= link_to('Contact us', page_path(first_contact_page.slug)) %>
      <% end %>
    <% else %>
      <% if Hcms.config.contact_tel_human.present? %>
        <%= link_to Hcms.config.contact_tel_human, "tel:#{ Hcms.config.contact_tel_full }" %> |
      <% end %>
      <% if Hcms.config.contact_email.present? %>
        <%= mail_to Hcms.config.contact_email %>
      <% end %>
    <% end %>
  </nav>

  <nav class="social_menu">
    <% if Hcms.config.facebook.present? %>
      <a target="_blank" href="<%= Hcms.config.facebook %>"><i class="fa fa-facebook-official"></i></a>
    <% end %>
    <% if Hcms.config.twitter.present? %>
      <a target="_blank" href="<%= Hcms.config.twitter %>"><i class="fa fa-twitter-square"></i></a>
    <% end %>
    <% if Hcms.config.instagram.present? %>
      <a target="_blank" href="<%= Hcms.config.instagram %>"><i class="fa fa-instagram"></i></a>
    <% end %>
  </nav>
</section>

<% if Hcms.config.footer_summary.present? %>
  <section class="footer_suffix">
    <%= Hcms.config.footer_summary.html_safe %>
  </section>
<% end %>
