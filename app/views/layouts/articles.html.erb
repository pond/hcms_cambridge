<!DOCTYPE html>
<html>
  <head>
    <%= render partial: 'layouts/content_preamble', locals: { content: @article } %>
    <title><%= Rails.application.config.uk_org_pond_hcms.site_name %>: <%= @article.title %></title>
  </head>

  <body>
    <header>
      <%= render partial: 'layouts/content_header', locals: { content: @article } %>
    </header>

    <main>
      <%= render partial: 'layouts/content_main', locals: { content: @article } %>
    </main>

    <footer>
      <% content_for :signed_in_cms_menu do %>
        <%= artshelp_edit_link_for(@article, params) %> |
        <%= link_to 'New blog article', new_admin_page_article_path() %> |
        <%= link_to 'List articles', admin_page_articles_path() %> |
        <%= link_to 'New page', new_admin_page_path() %>
      <% end %>

      <%= render partial: 'layouts/content_footer', locals: { content: @page } %>
    </footer>
  </body>
</html>
