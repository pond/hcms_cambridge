<%# Render with current Page or Article in "content" %>

<section class="header_content">
  <%=
    image_tag(
      'logo.svg',
      id:     'logo',
      alt:    'Logo',
      width:  Hcms.config.logo_w,
      height: Hcms.config.logo_h
    )
  %>

  <nav class="main_menu">
    <% if @page && @page.navigation_title.present? %>
      <h1 id="navigation_title"><%= @page.navigation_title %></h1>
    <% end %>

    <div class="pure-menu pure-menu-horizontal">
      <ul class="pure-menu-list">
        <% Page.top_level.for_navigation.includes(:revisions, {children_for_navigation: :revisions}).each do | top_level_page | %>
          <%
            nav_list_classes = %w{pure-menu-item pure-menu-allow-hover}
            nav_list_classes << 'pure-menu-has-children' if top_level_page.children_for_navigation.any?
            nav_list_classes << 'current' if (
              (content.is_a?(Article) && (top_level_page.id == content.page_id)) ||
              (content.is_a?(Event) && (top_level_page.id == content.page_id)) ||
              (content.is_a?(Page) && (top_level_page.id == content.id || top_level_page.id == content.parent.try(:id)))
            )

            top_level_page_title_to_show = if top_level_page == @page
              @page.displayed_revision.title
            else
              top_level_page.title
            end
          %>

          <%= tag.li(class: nav_list_classes) do %>
            <%= link_to(top_level_page_title_to_show, page_path(id: top_level_page.slug), class: 'pure-menu-link') %>
            <% if top_level_page.children_for_navigation.any? %>
              <ul class="pure-menu-children">
                <% top_level_page.children_for_navigation.each do | child_page | %>
                  <%
                    child_page_title_to_show = if child_page == @page
                      @page.displayed_revision.title
                    else
                      child_page.title
                    end
                  %>
                  <li class="pure-menu-item">
                    <%= link_to(child_page_title_to_show, page_path(id: child_page.slug), class: 'pure-menu-link') %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    </div>
  </nav>
</section>
