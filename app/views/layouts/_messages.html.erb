<%# Render flash data, via 'notice' or 'alert' locals %>
<% if notice.present? || alert.present? %>
      <section class="messages">
<%   if notice.present? %>
        <p class="notice"><%= notice %></p>
<%   end %>
<%   if alert.present? %>
        <p class="alert"><%= alert %></p>
<%   end %>
      </section>
<% end %>
