<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=0.8">

    <title><%= Hcms.config.site_name %>: Admin</title>

    <%= stylesheet_link_tag    'admin', media: 'all' %>
    <%= javascript_include_tag 'admin'               %>

    <%= csrf_meta_tags %>
    <%= render partial: 'layouts/google_tags' %>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
  </head>

  <body>
    <header>
      <section class="header_content">
        <img id="logo" alt="Logo" src="<%= image_path('logo.svg')%>" width="<%= Hcms.config.logo_w %>" height="<%= Hcms.config.logo_h %>">

        <nav class="main_menu">
          <h1 id="navigation_title">Site administration</h1>

          <div class="pure-menu pure-menu-horizontal">
            <ul class="pure-menu-list">
              <li class="pure-menu-item pure-menu-allow-hover">
                <%= link_to('Pages', admin_pages_path(), class: 'pure-menu-link') %>
              </li>
              <li class="pure-menu-item pure-menu-allow-hover">
                <%= link_to('Statistics', admin_statistics_path(), class: 'pure-menu-link') %>
              </li>
            </ul>
          </div>
        </nav>
      </section>
    </header>

    <main class="admin">
      <section class="main_content">
        <%= render :partial => 'layouts/messages' %>
        <%= yield %>
      </section>
    </main>

    <footer class="admin">
      <section class="footer_content">
        <%= content_for :extra_footer_links %>
        <%= link_to('Public site', root_path()) %>
        <% if user_signed_in? %>
          | <%= link_to('Log out', destroy_admin_user_session_path(), method: :delete) %>
        <% end %>
      </section>
    </footer>
  </body>
</html>
