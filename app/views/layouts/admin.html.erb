<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=0.8">

    <title><%= Rails.application.config.uk_org_pond_hcms.site_name %>: Admin</title>

    <%= stylesheet_link_tag    'admin', media: 'all' %>
    <%= javascript_include_tag 'admin'               %>

    <%= csrf_meta_tags %>
    <%= render partial: 'layouts/google_tags' %>
  </head>

  <body>
    <header>
      <section class="header_content">
        <img id="logo" alt="Logo" src="<%= image_path('logo.svg')%>" width="<%= Rails.application.config.uk_org_pond_hcms.logo_w %>" height="<%= Rails.application.config.uk_org_pond_hcms.logo_h %>">

        <nav class="main_menu">
          <h1>Site administration</h1>
        </nav>
      </section>
    </header>

    <main class="admin">
      <section class="main_content">
        <%= render :partial => 'layouts/messages' %>
        <%= yield %>
      </section>
    </main>

    <footer class="admin">
      <section class="footer_content">
        <%= link_to('Public site', root_path()) %> |
        <%= link_to('Pages', admin_pages_path()) %> |
        <%= link_to('Statistics', admin_statistics_path()) %> |
        <% if user_signed_in? %>
          <%= link_to('Log out', destroy_admin_user_session_path(), method: :delete) %> |
        <% end %>
      </section>
    </footer>
  </body>
</html>
