<!DOCTYPE html>
<html>
  <head>
    <%= render partial: 'layouts/content_preamble', locals: { content: @page } %>
    <title><%= Rails.application.config.uk_org_pond_hcms.site_name %>: <%= @page.title %></title>
  </head>

  <body>
    <header>
      <%= render partial: 'layouts/content_header', locals: { content: @page } %>
    </header>

    <main>
      <%= render partial: 'layouts/content_main', locals: { content: @page } %>
    </main>

    <footer>
      <% content_for :signed_in_cms_menu do %>
        <% if @page.is_a?(Page) %>
          <% if @page.is_blog_type? %>
            <%= link_to 'New article', new_admin_page_article_path(page_id: @page.id) %> |
            <%= link_to 'List articles', admin_page_articles_path(page_id: @page.id) %> |
            <%= pageshelp_edit_link_for(@page, params) %> |
          <% else %>
            <%= pageshelp_edit_link_for(@page, params) %> |
            <%= link_to 'New page', new_admin_page_path() %> |
          <% end %>
        <% else %>
          <%= link_to 'New page', new_admin_page_path() %> |
        <% end %>
        <%= link_to 'Page management', admin_pages_path() %>
      <% end %>

      <%= render partial: 'layouts/content_footer', locals: { content: @page } %>
    </footer>
  </body>
</html>
