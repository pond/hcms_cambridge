<% google_ad_id = ENV['GOOGLE_AD_ID'] %>

<% if google_ad_id.present? %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= google_ad_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= google_ad_id %>');
  </script>
<% end %>
