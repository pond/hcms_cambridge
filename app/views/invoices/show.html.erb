<%
  expected_price = @order.event.price_per_seat * @order.number_of_seats
  actual_price   = @order.amount_owed
%>

<h1>
  <% if Hcms.config.tax_number.present? %>
    Tax Invoice
  <% else %>
    Invoice
  <% end %>
</h1>

<table id="invoice-meta">
  <tr>
    <th>Invoice No.</th>
    <td><%= @order.human_invoice_number %></td>
  </tr>
  <tr>
    <th>Issue Date</th>
    <td><%= apphelp_human_time(@order.created_at, invoice: true) %></td>
  </tr>
  <tr>
    <th>Due Date</th>
    <td><%= apphelp_human_time(@order.event.starts_at - 1.day, invoice: true) %></td>
  </tr>
<table>

<p>
  <strong>Bill To</strong>
</p>

<ul>
  <li><%= @order.name %></li>
  <li><code><%= @order.email %></code></li>
  <% if @order.phone_number.present? %>
    <li><%= @order.phone_number %></li>
  <% end %>
  <% if @order.address.present? %>
    <li>
      <address>
        <%= h(@order.address).gsub(/\n+/, '<br>').html_safe() %>
      </address>
    </li>
  <% end %>
</ul>

<table id="invoice-lines">
  <thead>
    <tr>
      <th>Event</th>
      <th>Seats</th>
      <th>Per seat</th>
      <th class="amounts">Amount</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @order.event.title %></td>
      <td><%= @order.number_of_seats %></td>
      <td>
        <% if expected_price == actual_price %>
          <%= apphelp_money(@order.event.price_per_seat, currency: @order.event.currency) %></td>
        <% else %>
          Special price
        <% end %>
      </td>
      <td class="amounts">
        <%= apphelp_money(actual_price, currency: @order.event.currency) %>
      </td>
    </tr>
    <tr>
      <td colspan="3">
        Total (<%= @order.event.currency %>) incl. <%= Hcms.config.tax_name.presence || 'tax' %>
        <% if Hcms.config.tax_number.present? %>
          (<%= Hcms.config.tax_number %>)
        <% end %>
      </td>
      <td class="amounts">
        <%= apphelp_money(actual_price, currency: @order.event.currency) %>
      </td>
    </tr>
    <tr>
      <td colspan="3"></td>
      <td class="amounts">
        <% if @order.state_paid? %>
          <strong>PAID IN FULL</strong>
        <% else %>
          Due by<br>
          <%= apphelp_human_time(@order.event.starts_at - 1.day, date_only: true) %>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<p style="text-align: center">
  <% unless Hcms.config.footer_summary.include?(Hcms.config.site_name) %>
    <%= tag.strong(Hcms.config.site_name) %>
    &ndash;
  <% end %>
  <%= Hcms.config.footer_summary.html_safe %>
  <% if Hcms.config.tax_number.present? %>
    &ndash;
    <%= tag.strong do %>
      <%= Hcms.config.tax_name.presence || 'tax' %>
      <%= Hcms.config.tax_number %>
    <% end %>
  <% end %>
</p>

