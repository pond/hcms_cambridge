<%
  actual_price   = @encounter_order.amount_owed
  itemised_total = @encounter_order.encounter_order_items.sum(&:amount_owed) # (done in Ruby, not in DB)

  expected_physical_price = if @encounter_order.has_physical
    @encounter_order.frozen_price_physical
  else
    0
  end

  expected_seat_price = if @encounter_order.price_agreed_by_application?
    @encounter_order.amount_owed - expected_physical_price
  else
    @encounter_order.frozen_price_per_seat * @encounter_order.number_of_seats
  end

  difference_amount = if @encounter_order.encounter_order_items.any?
    actual_price - itemised_total - expected_physical_price
  else
    actual_price - expected_seat_price - expected_physical_price
  end
%>

<h1>
  <% if Hcms.config.tax_number.present? %>
    Tax Invoice
  <% else %>
    Invoice
  <% end %>
</h1>

<table id="invoice-meta">
  <tr>
    <th>Invoice No.</th>
    <td><%= @encounter_order.human_invoice_number %></td>
  </tr>
  <tr>
    <th>Issue Date</th>
    <td><%= apphelp_human_time(@encounter_order.created_at, invoice: true) %></td>
  </tr>
  <tr>
    <th>Due Date</th>
    <td><%= encordshelp_formatted_invoice_due_date(@encounter_order) %></td>
  </tr>
<table>

<p>
  <strong>Bill To</strong>
</p>

<ul>
  <li><%= @encounter_order.name %></li>
  <li><code><%= @encounter_order.email %></code></li>
  <% if @encounter_order.phone_number.present? %>
    <li><%= @encounter_order.phone_number %></li>
  <% end %>
  <% if @encounter_order.address.present? %>
    <li>
      <address>
        <%= h(@encounter_order.address).gsub(/\n+/, '<br>').html_safe() %>
      </address>
    </li>
  <% end %>
</ul>

<table id="invoice-lines">
  <thead>
    <tr>
      <th>Item</th>
      <th>Quantity</th>
      <th>Unit price</th>
      <th class="amounts">Total</th>
    </tr>
  </thead>
  <tbody>
    <% if @encounter_order.encounter_order_items.any? %>
      <% @encounter_order.encounter_order_items.each do | item | %>
        <tr>
          <td><%= item.description %></td>
          <td>1</td>
          <td>
            <%= apphelp_money(item.amount_owed, currency: @encounter_order.encounter.currency) %>
          </td>
          <td class="amounts">
            <%= apphelp_money(item.amount_owed, currency: @encounter_order.encounter.currency) %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td><%= @encounter_order.encounter.title %></td>
        <td><%= @encounter_order.number_of_seats %></td>
        <td>
          <% if @encounter_order.price_agreed_by_application? %>
            Custom price
          <% elsif expected_seat_price == actual_price - expected_physical_price %>
            <%= apphelp_money(@encounter_order.frozen_price_per_seat, currency: @encounter_order.encounter.currency) %>
          <% else %>
            Special price
          <% end %>
        </td>
        <td class="amounts">
          <%= apphelp_money(actual_price - expected_physical_price, currency: @encounter_order.encounter.currency) %>
        </td>
      </tr>
    <% end %>
    <% if @encounter_order.has_physical %>
      <tr>
        <td><%= @encounter_order.encounter.name_physical.upcase_first %></td>
        <td>1</td>
        <td>
          <%= apphelp_money(expected_physical_price, currency: @encounter_order.encounter.currency) %>
        </td>
        <td class="amounts">
          <%= apphelp_money(expected_physical_price, currency: @encounter_order.encounter.currency) %>
        </td>
      </tr>
    <% end %>
    <% unless difference_amount.zero? %>
      <tr>
        <td><%= difference_amount > 0 ? "Other charges" : "Discount" %></td>
        <td>1</td>
        <td>
          <%= apphelp_money(difference_amount, currency: @encounter_order.encounter.currency) %>
        </td>
        <td class="amounts">
          <%= apphelp_money(difference_amount, currency: @encounter_order.encounter.currency) %>
        </td>
      </tr>
    <% end %>
    <% if @encounter_order.all_prices_exclude_sales_tax? %>
      <tr>
        <td colspan="3">
          <strong>Total excluding <%= Hcms.config.tax_name %></strong>
        </td>
        <td class="amounts">
          <strong>
            <%= apphelp_money(@encounter_order.amount_owed, currency: @encounter_order.encounter.currency) %>
          </strong>
        </td>
      </tr>
      <tr>
        <td colspan="3">
          Plus <%= Hcms.config.tax_name %> at <%= Hcms.config.tax_rate %>%
        </td>
        <td class="amounts">
          <%= apphelp_money(@encounter_order.amount_of_tax_owed, currency: @encounter_order.encounter.currency) %>
        </td>
      </tr>
    <% end %>
    <tr>
      <td colspan="3">
        <strong>
          Total (<%= @encounter_order.encounter.currency %>) incl. <%= Hcms.config.tax_name.presence || 'tax' %>
          <% if Hcms.config.tax_number.present? %>
            (<%= Hcms.config.tax_number %>)
          <% end %>
        </strong>
      </td>
      <td class="amounts">
        <strong>
          <%= apphelp_money(@encounter_order.amount_owed_plus_tax, currency: @encounter_order.encounter.currency) %>
        </strong>
      </td>
    </tr>
    <tr>
      <td colspan="3"></td>
      <td class="amounts">
        <% if @encounter_order.state_paid? %>
          <strong>PAID IN FULL</strong>
        <% else %>
          Due by<br>
          <%= encordshelp_formatted_invoice_due_date(@encounter_order) %>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<p style="text-align: center">
  <% unless Hcms.config.footer_summary.include?(Hcms.config.site_name) %>
    <%= tag.strong(Hcms.config.site_name) %>
    &ndash;
  <% end %>
  <%= Hcms.config.footer_summary.html_safe %>
  <% if Hcms.config.tax_number.present? %>
    &ndash;
    <%= tag.strong do %>
      <%= Hcms.config.tax_name.presence || 'tax' %>
      <%= Hcms.config.tax_number %>
    <% end %>
  <% end %>
</p>
